+  /** Lazily built index of {@code src} and {@code result} URIs to file info, kept in sync by add/remove. */
+  private volatile Map<URI, FileInfo> srcResultIndex;
+
+  private Map<URI, FileInfo> srcResultIndex() {
+    Map<URI, FileInfo> idx = srcResultIndex;
+    if (idx == null) {
+      synchronized (this) {
+        idx = srcResultIndex;
+        if (idx == null) {
+          idx = new ConcurrentHashMap<>();
+          for (final FileInfo fi : files.values()) {
+            indexFileInfo(idx, fi);
+          }
+          srcResultIndex = idx;
+        }
+      }
+    }
+    return idx;
+  }
+
+  private static void indexFileInfo(final Map<URI, FileInfo> idx, final FileInfo fi) {
+    if (fi.src != null) {
+      idx.putIfAbsent(fi.src, fi);
+    }
+    if (fi.result != null) {
+      idx.putIfAbsent(fi.result, fi);
+    }
+  }
+
+  private static void unindexFileInfo(final Map<URI, FileInfo> idx, final FileInfo fi) {
+    if (fi.src != null) {
+      idx.remove(fi.src, fi);
+    }
+    if (fi.result != null) {
+      idx.remove(fi.result, fi);
+    }
+  }
