<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="setup-de">
  <title>Einrichtung des Wasserkochers</title>
  <body>
    <section>
      <title>Lieferumfang</title>
      <ul>
        <li>1x <keyword keyref="product-name"/> Wasserkocher</li>
        <li>1x Sockel mit Netzkabel</li>
        <li>1x Bedienungsanleitung</li>
      </ul>
      <fig>
        <title><keyword keyref="product-name"/></title>
        <image keyref="img-kettle-front" width="200px">
          <alt>Vorderansicht des <keyword keyref="product-name"/></alt>
        </image>
      </fig>
    </section>
    <section>
      <title>Ersteinrichtung</title>
      <ol>
        <li>Entfernen Sie alle Verpackungsmaterialien vom <keyword keyref="product-name"/>.</li>
        <li>Spülen Sie das Innere des Wasserkochers mit sauberem Wasser.</li>
        <li>Stellen Sie den Sockel auf eine ebene, trockene Fläche in der Nähe einer
          <keyword keyref="socket-type"/>-Steckdose.</li>
        <li>Stecken Sie den Stecker in die <keyword keyref="socket-type"/>-Wandsteckdose.</li>
        <li>Füllen Sie den Wasserkocher bis zur MAX-Markierung und kochen Sie einmal auf.
          Schütten Sie dieses Wasser weg.</li>
      </ol>
    </section>
  </body>
</topic>
