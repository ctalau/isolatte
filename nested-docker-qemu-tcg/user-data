#cloud-config

# Install Docker (Alpine uses OpenRC, not systemd)
packages:
  - docker

runcmd:
  # Start Docker daemon (OpenRC service)
  - rc-update add docker default
  - rc-service docker start

  # Confirm L0 Docker is up
  - |
    i=0
    until docker info >/dev/null 2>&1; do
      i=$((i+1))
      [ $i -gt 36 ] && { echo "EXPERIMENT_FAILED: L0 dockerd never became ready"; exit 1; }
      echo "[wait] L0 dockerd not ready yet (attempt $i)..."
      sleep 10
    done
    echo "[ok] L0 dockerd ready"

  # ── Layer 1: privileged Docker-in-Docker ──────────────────────────────
  # Use vfs storage driver to avoid overlay-on-overlay nesting limits.
  - |
    echo "[step] Starting L1 DinD container..."
    docker run \
      --privileged \
      --name dind_l1 \
      -d \
      docker:dind \
      --storage-driver=vfs

  # Wait for L1's own dockerd to become reachable
  - |
    i=0
    until docker exec dind_l1 docker info >/dev/null 2>&1; do
      i=$((i+1))
      [ $i -gt 60 ] && { echo "EXPERIMENT_FAILED: L1 dockerd never became ready"; exit 1; }
      echo "[wait] L1 dockerd not ready yet (attempt $i)..."
      sleep 10
    done
    echo "[ok] L1 dockerd ready"

  # ── Layer 2: privileged DinD inside L1 ───────────────────────────────
  - |
    echo "[step] Starting L2 DinD container inside L1..."
    docker exec dind_l1 docker run \
      --privileged \
      --name dind_l2 \
      -d \
      docker:dind \
      --storage-driver=vfs

  # Wait for L2's dockerd (exec chain: VM → L1 → L2)
  - |
    i=0
    until docker exec dind_l1 docker exec dind_l2 docker info >/dev/null 2>&1; do
      i=$((i+1))
      [ $i -gt 60 ] && { echo "EXPERIMENT_FAILED: L2 dockerd never became ready"; exit 1; }
      echo "[wait] L2 dockerd not ready yet (attempt $i)..."
      sleep 10
    done
    echo "[ok] L2 dockerd ready"

  # ── Layer 3: run Node.js container inside L2 ─────────────────────────
  - |
    echo "[step] Running node container inside L2..."
    OUTPUT=$(docker exec dind_l1 docker exec dind_l2 \
      docker run --rm node:alpine \
      node -e "console.log('deep hello world')")
    echo "[result] $OUTPUT"
    echo "EXPERIMENT_DONE: $OUTPUT"
