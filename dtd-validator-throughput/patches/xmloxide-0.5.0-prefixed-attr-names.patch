+/// The attribute name as written in the document (`prefix:local`), which is
+/// how a DTD declares it (e.g. `xml:space`).
+fn attr_qname(attr: &crate::tree::Attribute) -> std::borrow::Cow<'_, str> {
+    match &attr.prefix {
+        Some(p) => std::borrow::Cow::Owned(format!("{p}:{}", attr.name)),
+        None => std::borrow::Cow::Borrowed(attr.name.as_str()),
+    }
+}
